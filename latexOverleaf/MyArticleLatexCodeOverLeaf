\subsection{Exemples d'extraits de code}
\subsubsection*{Exemple 1 : Integration CI/CD avec GitHub Actions}
\begin{lstlisting}[language=yaml, caption={Workflow GitHub Actions integrant MobileSec-MS.}]
name: Mobile Security Scan
on: [push, pull_request]
jobs:
  security-scan:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v3
      - name: Build APK
        run: ./gradlew assembleDebug
      - name: MobileSec-MS Analysis
        run: |
          curl -X POST "http://your-gateway:8083/api/ci/scan" \
          -H "X-API-KEY: ${{ secrets.MOBILESEC_API_KEY }}" \
          -F "apk=@app/build/outputs/apk/debug/app-debug.apk"
        continue-on-error: false # Le pipeline echoue si l'analyse echoue
\end{lstlisting}

